<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.linxing.linxing_agent.mapper.ChunkMapper">

    <resultMap id="BaseResultMap" type="org.linxing.linxing_agent.entity.Chunk">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="document_id" property="documentId"/>
        <result column="parent_chunk_id" property="parentChunkId"/>
        <result column="chunk_level" property="chunkLevel"/>
        <result column="chunk_text" property="chunkText"/>
        <result column="chunk_type" property="chunkType"/>
        <result column="title_path" property="titlePath"/>
        <result column="context_prefix" property="contextPrefix"/>
        <result column="source_strategy" property="sourceStrategy"/>
        <result column="is_searchable" property="isSearchable"/>
        <result column="ts_content" property="tsContent"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <sql id="BaseColumnList">
        id, user_id, document_id, parent_chunk_id, chunk_level, chunk_text,
        chunk_type, title_path, context_prefix, source_strategy,
        is_searchable, ts_content, created_at
    </sql>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO chunks (user_id, document_id, parent_chunk_id, chunk_level, chunk_text,
                            chunk_type, title_path, context_prefix, source_strategy,
                            is_searchable)
        VALUES (#{userId}, #{documentId}, #{parentChunkId}, #{chunkLevel}, #{chunkText},
                #{chunkType}, #{titlePath}, #{contextPrefix}, #{sourceStrategy},
                #{isSearchable})
    </insert>

    <select id="findById" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumnList"/>
        FROM chunks
        WHERE id = #{id}
    </select>

    <select id="findByDocumentId" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumnList"/>
        FROM chunks
        WHERE document_id = #{documentId}
        ORDER BY id ASC
    </select>

    <select id="findByUserId" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumnList"/>
        FROM chunks
        WHERE user_id = #{userId}
        ORDER BY created_at DESC
    </select>

    <select id="findByIds" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumnList"/>
        FROM chunks
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <delete id="deleteById">
        DELETE FROM chunks WHERE id = #{id}
    </delete>

    <update id="update">
        <![CDATA[
        UPDATE chunks SET
            chunk_type = #{chunkType},
            title_path = #{titlePath},
            context_prefix = #{contextPrefix},
            is_searchable = #{isSearchable},
            ts_content = to_tsvector('simple', #{tsContent})
        WHERE id = #{id}
        ]]>
    </update>

    <delete id="deleteByDocumentId">
        DELETE FROM chunks WHERE document_id = #{documentId}
    </delete>

    <delete id="deleteByUserId">
        DELETE FROM chunks WHERE user_id = #{userId}
    </delete>

</mapper>
