<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.linxing.linxing_agent.mapper.ChunkMapper">

    <resultMap id="BaseResultMap" type="org.linxing.linxing_agent.entity.Chunk">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="document_id" property="documentId"/>
        <result column="chunk_text" property="chunkText"/>
        <result column="page_number" property="pageNumber"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <sql id="BaseColumnList">
        id, user_id, document_id, chunk_text, page_number, created_at
    </sql>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO chunks (user_id, document_id, chunk_text, page_number)
        VALUES (#{userId}, #{documentId}, #{chunkText}, #{pageNumber})
    </insert>

    <select id="findById" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumnList"/>
        FROM chunks
        WHERE id = #{id}
    </select>

    <select id="findByDocumentId" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumnList"/>
        FROM chunks
        WHERE document_id = #{documentId}
        ORDER BY id ASC
    </select>

    <select id="findByUserId" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumnList"/>
        FROM chunks
        WHERE user_id = #{userId}
        ORDER BY created_at DESC
    </select>

    <select id="findByIds" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumnList"/>
        FROM chunks
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <delete id="deleteById">
        DELETE FROM chunks WHERE id = #{id}
    </delete>

    <delete id="deleteByDocumentId">
        DELETE FROM chunks WHERE document_id = #{documentId}
    </delete>

    <delete id="deleteByUserId">
        DELETE FROM chunks WHERE user_id = #{userId}
    </delete>

</mapper>
